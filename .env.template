# ============================================================
# 《无尽的拉格朗日》AI 战术推演中心 — 环境配置文件
# ============================================================
# 使用说明：
#   1. 复制此文件为 .env（即：.env.template → .env）
#   2. 填入你的 DeepSeek API Key
#   3. 其他配置项已有默认值，通常无需修改
# ============================================================

# ---------- DeepSeek API 配置（必填） ----------
# 从 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=your_api_key_here

# DeepSeek API 基础地址（通常无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名称
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- 管理员配置 ----------
# 管理员后台独立登录密码（请务必修改为强密码！）
ADMIN_PASSWORD=admin_lagrange_2024

# ---------- JWT 配置 ----------
# JWT 签名密钥（请修改为随机字符串）
JWT_SECRET=lagrange-jwt-secret-key-2024

# ---------- 数据库路径 ----------
# SQLite 数据库文件路径（相对于项目根目录）
DATABASE_PATH=./lagrange.db

# 数据库备份目录
DB_BACKUP_DIR=./db_backup

# ---------- ChromaDB 向量库路径 ----------
CHROMA_DB_PATH=./chroma_db

# ---------- 文档路径 ----------
# 项目内知识库文档目录
LAGRANGE_DOCS_PATH=./lagrange_docs

# 桌面「质料」文件夹路径（Windows 中文路径兼容）
# %USERPROFILE% 会自动展开为 C:/Users/你的用户名
DESKTOP_MATERIALS_PATH=C:/Users/Administrator/Desktop/质料

# ---------- 服务器配置 ----------
# 监听地址（0.0.0.0 表示接受局域网所有设备访问）
HOST=0.0.0.0

# 监听端口
PORT=3000
