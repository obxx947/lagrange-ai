# ============================================================
# Lagrange Tactical AI — Production Environment Variables
# WARNING: All secrets MUST be changed before production deployment!
# ============================================================

# ---- DeepSeek AI Configuration ----
DEEPSEEK_API_KEY=sk-your-production-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.5
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_RETRIES=2

# ---- Security Configuration ----
# CHANGE THESE VALUES! Use strong random passwords.
ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_ADMIN_PASSWORD_MIN_16_CHARS
JWT_SECRET=CHANGE_THIS_TO_CRYPTOGRAPHICALLY_RANDOM_64_CHARACTER_STRING
JWT_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_TO_RANDOM_STRING

# ---- Path Configuration ----
DATABASE_PATH=/app/data/lagrange.db
DB_BACKUP_DIR=/app/data/db_backup
CHROMA_DB_PATH=/app/data/chroma_db
LAGRANGE_DOCS_PATH=/app/lagrange_docs
DESKTOP_MATERIALS_PATH=/app/materials
EXPORT_DIR=/app/data/exports
STATIC_DIR=/app/static
LOG_DIR=/app/logs

# ---- Server Configuration ----
APP_ENV=production
HOST=0.0.0.0
PORT=3000
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
RELOAD=false
WORKERS=4
TIMEOUT_KEEP_ALIVE=65
GRACEFUL_TIMEOUT=30

# ---- Performance Configuration ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=3600
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
MAX_CONCURRENT_BATTLES=100
BATTLE_TIMEOUT_SECONDS=300

# ---- Cache Configuration ----
REDIS_HOST=lagrange-redis-svc
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# ---- User Configuration ----
DEFAULT_NEW_USER_TOKENS=10000
MAX_TOKENS_PER_USER=1000000
TOKEN_COST_PER_CHAT=1
TOKEN_COST_PER_BATTLE_SIM=5
TOKEN_COST_PER_FLEET_OPT=3

# ---- Scheduled Tasks ----
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=1
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
SESSION_EXPIRE_DAYS=7
CHAT_RECORD_EXPIRE_DAYS=14

# ---- Monitoring ----
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multi

# ---- Feature Flags ----
FEATURE_BATTLE_SIM=true
FEATURE_FLEET_OPTIMIZER=true
FEATURE_AI_CHAT=true
FEATURE_RAG_RETRIEVAL=true
FEATURE_USER_REGISTRATION=true
FEATURE_ADMIN_PANEL=true
FEATURE_EXPORT_CSV=true

# ---- Security Hardening ----
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=random
PYTHONWARNINGS=ignore
PYTHONASYNCIODEBUG=0
SQLALCHEMY_ECHO=false
UVICORN_LOG_LEVEL=warning
FORWARDED_ALLOW_IPS=*

# ---- External Integrations ----
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SENTRY_DSN=
