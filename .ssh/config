# ============================================================
# Lagrange Tactical AI - SSH Client Configuration
# Connection settings for deployment and remote management
# ============================================================

# ---- Default settings ----
Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes
    StrictHostKeyChecking ask
    UserKnownHostsFile ~/.ssh/known_hosts
    ServerAliveInterval 60
    ServerAliveCountMax 5
    TCPKeepAlive yes
    Compression yes
    ConnectTimeout 15
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 600

# ---- Lagrange Production Server ----
Host lagrange-prod
    HostName 10.0.1.100
    User lagrange
    Port 22
    IdentityFile ~/.ssh/lagrange_prod_ed25519
    ForwardAgent no
    LogLevel ERROR
    PreferredAuthentications publickey

# ---- Lagrange Staging Server ----
Host lagrange-staging
    HostName 10.0.2.100
    User lagrange
    Port 22
    IdentityFile ~/.ssh/lagrange_staging_ed25519
    ForwardAgent no
    LogLevel INFO

# ---- Lagrange Kubernetes Bastion ----
Host lagrange-bastion
    HostName bastion.lagrange.example.com
    User lagrange
    Port 2222
    IdentityFile ~/.ssh/lagrange_bastion_ed25519
    ForwardAgent yes
    LocalForward 6443 kubernetes-api.lagrange.local:6443
    LocalForward 9090 prometheus.lagrange.local:9090
    LocalForward 3000 grafana.lagrange.local:3000

# ---- Lagrange CI/CD Runner ----
Host lagrange-cicd
    HostName cicd.lagrange.example.com
    User deploy
    Port 22
    IdentityFile ~/.ssh/lagrange_cicd_ed25519
    ForwardAgent no
    StrictHostKeyChecking accept-new

# ---- GitHub ----
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github_lagrange_ed25519
    AddKeysToAgent yes
    PreferredAuthentications publickey

# ---- GitLab ----
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/gitlab_lagrange_ed25519
    PreferredAuthentications publickey

# ---- Quick deploy alias ----
Host deploy
    HostName 10.0.1.100
    User lagrange
    IdentityFile ~/.ssh/lagrange_prod_ed25519
    RemoteCommand cd /app && git pull && docker compose up -d --build
    RequestTTY force
