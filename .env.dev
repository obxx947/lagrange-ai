# ============================================================
# Lagrange Tactical AI — Development Environment Variables
# Copy this file to .env and customize values
# ============================================================

# ---- DeepSeek AI Configuration ----
DEEPSEEK_API_KEY=sk-your-dev-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3

# ---- Security Configuration ----
ADMIN_PASSWORD=admin_lagrange_dev_2024
JWT_SECRET=lagrange-jwt-dev-secret-key-not-for-production-change-me
JWT_EXPIRE_DAYS=7
BCRYPT_ROUNDS=4
SESSION_SECRET=dev-session-secret-key-change-in-production

# ---- Path Configuration ----
DATABASE_PATH=./lagrange_dev.db
DB_BACKUP_DIR=./db_backup
CHROMA_DB_PATH=./chroma_db_dev
LAGRANGE_DOCS_PATH=./lagrange_docs
DESKTOP_MATERIALS_PATH=./test_materials
EXPORT_DIR=./exports
STATIC_DIR=./static
LOG_DIR=./logs

# ---- Server Configuration ----
APP_ENV=development
HOST=127.0.0.1
PORT=3000
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text
RELOAD=true
WORKERS=1
TIMEOUT_KEEP_ALIVE=65
GRACEFUL_TIMEOUT=30

# ---- Performance Configuration ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=3600
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
MAX_CONCURRENT_BATTLES=10
BATTLE_TIMEOUT_SECONDS=300

# ---- Cache Configuration ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=600
CACHE_ENABLED=false

# ---- User Configuration ----
DEFAULT_NEW_USER_TOKENS=100000
MAX_TOKENS_PER_USER=10000000
TOKEN_COST_PER_CHAT=1
TOKEN_COST_PER_BATTLE_SIM=5
TOKEN_COST_PER_FLEET_OPT=3

# ---- Scheduled Tasks ----
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=1
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 3 * * *
SESSION_EXPIRE_DAYS=7
CHAT_RECORD_EXPIRE_DAYS=14

# ---- Monitoring ----
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
TRACING_SAMPLE_RATE=1.0
PROMETHEUS_MULTIPROC_DIR=

# ---- Feature Flags ----
FEATURE_BATTLE_SIM=true
FEATURE_FLEET_OPTIMIZER=true
FEATURE_AI_CHAT=true
FEATURE_RAG_RETRIEVAL=true
FEATURE_USER_REGISTRATION=true
FEATURE_ADMIN_PANEL=true
FEATURE_EXPORT_CSV=true

# ---- Development Tools ----
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=0
PYTHONDEVMODE=1
PYTHONWARNINGS=default
PYTHONASYNCIODEBUG=1
SQLALCHEMY_ECHO=true
UVICORN_LOG_LEVEL=debug

# ---- External Integrations (dev) ----
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SENTRY_DSN=
