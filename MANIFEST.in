include pyproject.toml
include setup.py
include setup.cfg
include MANIFEST.in
include requirements.txt
include requirements-dev.txt
include Makefile
include Dockerfile
include Dockerfile.dev
include docker-compose*.yml
include VERSION

include *.py
include *.html
include *.css
include *.js
include *.json
include *.yaml
include *.yml
include *.toml
include *.cfg
include *.ini
include *.md
include *.rst
include *.adoc
include *.sh
include *.bat
include *.ps1
include *.sql
include *.graphql
include *.txt
include *.xml
include *.properties
