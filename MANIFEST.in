recursive-include src/lagrange *.py *.pyx *.pxd *.c *.h *.cpp *.hpp *.so *.pyd
recursive-include static *
recursive-include public *
recursive-include templates *
recursive-include docs *.md *.rst *.yaml *.json *.graphql
recursive-include config *.yml *.yaml *.json *.conf *.properties *.toml
recursive-include k8s *.yaml *.yml *.json
recursive-include certs *.key *.pem *.crt *.csr *.jks *.p12 *.pfx
recursive-include scripts *.sh *.py *.js *.bat *.ps1
recursive-include lagrange_docs *.txt *.md *.json *.html
recursive-include exports *.csv *.tsv *.txt *.json
recursive-include tests *.py *.json *.yaml *.yml
recursive-include .github *.yml *.yaml *.md *.json

recursive-exclude * __pycache__
recursive-exclude * *.pyc
recursive-exclude * *.pyo
recursive-exclude * *.so
recursive-exclude * *.pyd
recursive-exclude * .DS_Store
recursive-exclude * Thumbs.db
recursive-exclude * *.log
recursive-exclude * node_modules
recursive-exclude * .git
recursive-exclude * .idea
recursive-exclude * .vscode
recursive-exclude * chroma_db
recursive-exclude * db_backup

global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .git
prune tests/__pycache__
prune src/lagrange/__pycache__
