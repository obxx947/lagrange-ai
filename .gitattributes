# Auto-detect text files, ensure LF line endings
* text=auto

# Source code
*.py text eol=lf diff=python
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.vue text eol=lf
*.svelte text eol=lf
*.astro text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.adoc text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.graphql text eol=lf
*.proto text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.pl text eol=lf
*.hs text eol=lf
*.agda text eol=lf
*.idr text eol=lf

# C/C++/Rust
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.rs text eol=lf
CMakeLists.txt text eol=lf
Makefile text eol=lf
Cargo.toml text eol=lf

# Config files
.env text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.glb binary
*.gltf binary
*.mp4 binary
*.mp3 binary
*.ogg binary
*.wav binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.pdf binary
*.db binary
*.bin binary
*.sqlite3 binary
