# ============================================================
# EditorConfig — 跨编辑器统一代码风格
# 支持: VS Code, IntelliJ, Sublime, Vim, Emacs 等
# ============================================================

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4
max_line_length = 100

[*.js]
indent_size = 2

[*.ts]
indent_size = 2

[*.html]
indent_size = 2

[*.css]
indent_size = 2

[*.json]
indent_size = 2

[*.yaml]
indent_size = 2

[*.yml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.bat]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.sql]
indent_size = 2

[*.xml]
indent_size = 2
