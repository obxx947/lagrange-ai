Windows Registry Editor Version 5.00

; ============================================================
; 拉格朗日AI — 开机自启注册表项
; 双击此文件导入注册表，即可实现开机自动启动
; 如需取消：删除 HKCU\Software\Microsoft\Windows\CurrentVersion\Run\LagrangeAI
; ============================================================

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Run]
"LagrangeAI"="cmd /c \"set PATH=D:\\Python312;D:\\Python312\\Scripts;%PATH% && cd /d C:\\Users\\Administrator\\Desktop\\拉格朗日智能体 && start /MIN python main.py\""
