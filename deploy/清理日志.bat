@echo off
chcp 65001 >nul
:: ============================================================
:: 《无尽的拉格朗日》AI 战术推演中心 — 定时清理脚本
:: ============================================================
:: 功能：清理超过7天的登录日志 + 超过14天的聊天记录
:: 使用方式：
::   1. 手动双击运行此 bat 文件
::   2. 配置 Windows 任务计划程序实现开机自启/定时执行
::
:: 开机自启配置教程：
::   1. 按 Win+R，输入 taskschd.msc，打开任务计划程序
::   2. 点击右侧「创建基本任务」
::   3. 名称：拉格朗日数据清理
::   4. 触发器：选择「每天」或「计算机启动时」
::   5. 操作：选择「启动程序」，浏览选择此 bat 文件
::   6. 完成创建
:: ============================================================

echo ========================================
echo  拉格朗日AI助手 - 数据清理工具
echo ========================================
echo.

:: 获取脚本所在目录
set "SCRIPT_DIR=%~dp0"
cd /d "%SCRIPT_DIR%"

:: 检查 Python 是否可用
python --version >nul 2>&1
if %errorlevel% neq 0 (
    echo [错误] 未找到 Python，请确认已安装并添加到系统 PATH
    pause
    exit /b 1
)

echo [执行] 正在清理过期数据...
echo.

:: 调用 Python 清理函数
python -c "from database import cleanup_expired_data; print(cleanup_expired_data())"

if %errorlevel% equ 0 (
    echo.
    echo [完成] 数据清理已执行
) else (
    echo.
    echo [错误] 清理过程出现异常，请检查数据库文件是否正常
)

echo.
echo ========================================
pause
