# ============================================================
# Lagrange Tactical AI - npm Configuration
# ============================================================

# Registry mirror for faster installs in China
registry=https://registry.npmmirror.com

# Strict engine checking
engine-strict=true

# Always use exact versions
save-exact=true

# Lockfile should be committed
package-lock=true

# Audit on install
audit=true
audit-level=moderate

# Disable progress for CI speed
progress=false

# Preferred package manager
prefer-offline=true

# Script shell
script-shell=powershell

# Cache directory
cache=.npm-cache

# Log level
loglevel=warn

# Funding display
fund=false

# Update notifier
update-notifier=false
