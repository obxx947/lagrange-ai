# ============================================================
# 拉格朗日AI — 本地环境变量覆盖
# .env.local 优先级高于 .env
# 用于开发环境个性化配置
# ============================================================

# 开发模式（开启热重载）
DEV_MODE=true
LOG_LEVEL=debug

# 本地测试端口（避免冲突）
PORT=3001

# 跳过限流（开发用）
SKIP_RATE_LIMIT=true

# 测试用管理员密码（仅开发环境）
ADMIN_PASSWORD=dev_test_123
