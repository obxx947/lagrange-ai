// ============================================================================
// Lagrange Tactical AI - Battle Simulation Page Styles
// Stylus CSS Preprocessor - uses Stylus syntax (indentation-based, no braces)
// ============================================================================

// ---- Variables ----
bg-primary    = #0a0e1a
bg-card       = #111827
bg-dark       = #0f172a
border-color  = #1e3a8a
border-light  = #1e293b
text-primary  = #d0d8f0
text-secondary = #93c5fd
text-muted    = #64748b
accent        = #60a5fa
accent-hover  = #3b82f6
danger        = #ef4444
success       = #22c55e
warning       = #f59e0b
info          = #8b5cf6
font-family   = 'Segoe UI', 'Microsoft YaHei', sans-serif

// ---- Reset ----
*
  margin 0
  padding 0
  box-sizing border-box

body
  background bg-primary
  font-family font-family
  color text-primary
  padding 20px
  line-height 1.6

// ---- Battle Page Header ----
.battle-page-header
  text-align center
  padding 24px
  margin-bottom 24px
  background linear-gradient(135deg, bg-card, lighten(bg-card, 5%), bg-card)
  border 1px solid border-color
  border-radius 12px

  h1
    color accent
    font-size 26px
    letter-spacing 3px
    text-transform uppercase

  .meta
    color text-secondary
    font-size 11px
    margin-top 6px

// ---- Battle Arena ----
.battle-arena
  display flex
  gap 20px
  margin-bottom 24px
  min-height 400px

  @media (max-width: 1024px)
    flex-direction column

// ---- Fleet Panel (Left / Right) ----
.fleet-panel
  flex 1
  background bg-card
  border 1px solid border-color
  border-radius 8px
  padding 18px
  position relative

  &.alpha
    border-left 4px solid accent

  &.beta
    border-left 4px solid danger

  .fleet-name
    font-size 18px
    font-weight bold
    color #fff
    margin-bottom 14px
    text-align center
    padding-bottom 10px
    border-bottom 1px solid border-light

  .fleet-ships
    display flex
    flex-direction column
    gap 8px

  .fleet-ship-row
    display flex
    align-items center
    padding 10px
    background bg-dark
    border-radius 6px
    border 1px solid border-light
    transition all 0.2s ease

    &:hover
      background lighten(bg-dark, 10%)

    &.destroyed
      opacity 0.35
      text-decoration line-through
      background rgba(danger, 0.05)
      border-color fade(danger, 30%)

    .ship-icon
      width 32px
      height 32px
      background border-color
      border-radius 4px
      margin-right 12px
      flex-shrink 0

    .ship-info
      flex 2

      .ship-name
        font-weight bold
        font-size 13px

      .ship-type
        font-size 10px
        color text-muted

    .ship-hp-bar
      flex 3
      height 8px
      background border-light
      border-radius 4px
      overflow hidden
      margin 0 12px

      .hp-fill
        height 100%
        border-radius 4px
        transition width 0.5s ease

        &.healthy
          background success
        &.damaged
          background warning
        &.critical
          background danger

    .ship-hp-text
      font-size 11px
      min-width 50px
      text-align right

// ---- Battle Controls (Center) ----
.battle-controls
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 16px
  min-width 200px

  .vs-badge
    font-size 32px
    font-weight bold
    color @color

    &.alpha-color
      color accent

    &.beta-color
      color danger

  .simulate-btn
    padding 14px 36px
    background linear-gradient(135deg, accent, darken(accent, 15%))
    color #fff
    border none
    border-radius 8px
    cursor pointer
    font-size 16px
    font-weight bold
    letter-spacing 1px
    text-transform uppercase
    transition all 0.25s ease

    &:hover
      transform scale(1.05)
      box-shadow 0 4px 20px rgba(accent, 0.4)

    &:active
      transform scale(0.98)

    &:disabled
      opacity 0.5
      cursor not-allowed
      transform none

  .speed-control
    display flex
    align-items center
    gap 8px
    font-size 11px
    color text-muted

    input[type="range"]
      width 100px

// ---- Battle Log Panel ----
.battle-log-panel
  background bg-card
  border 1px solid border-color
  border-radius 8px
  overflow hidden

  .log-header-bar
    display flex
    justify-content space-between
    align-items center
    padding 12px 16px
    background bg-dark
    border-bottom 1px solid border-light

    h3
      color accent
      font-size 13px
      text-transform uppercase
      letter-spacing 1px

    .log-stats
      display flex
      gap 12px
      font-size 10px

      .log-stat
        padding 2px 8px
        border-radius 10px

        &.criticals
          background rgba(danger, 0.2)
          color danger

        &.kills
          background rgba(success, 0.2)
          color success

  .log-entries
    max-height 300px
    overflow-y auto
    padding 8px

    &::-webkit-scrollbar
      width 6px

    &::-webkit-scrollbar-track
      background bg-dark

    &::-webkit-scrollbar-thumb
      background border-color
      border-radius 3px

  .log-entry
    padding 7px 10px
    margin 2px 0
    border-radius 4px
    font-size 11px
    font-family 'Consolas', 'Courier New', monospace
    border-left 3px solid transparent
    animation fadeIn 0.2s ease

    .entry-time
      color text-muted
      margin-right 8px

    &.severity-critical
      background rgba(danger, 0.08)
      border-left-color danger
      color lighten(danger, 20%)

    &.severity-high
      background rgba(danger, 0.04)
      border-left-color lighten(danger, 20%)

    &.severity-medium
      background rgba(warning, 0.06)
      border-left-color warning

    &.severity-low
      background rgba(success, 0.04)
      border-left-color success

    &.severity-info
      background rgba(accent, 0.04)
      border-left-color accent

// ---- Battle Timeline Visualization ----
.timeline-viz
  background bg-card
  border 1px solid border-color
  border-radius 8px
  padding 20px
  margin-top 20px

  h3
    color accent
    font-size 14px
    margin-bottom 16px
    text-transform uppercase
    letter-spacing 1px

  .timeline-canvas-container
    position relative
    height 200px
    background bg-dark
    border-radius 6px
    overflow hidden

    canvas
      width 100%
      height 100%

// ---- Damage Distribution Chart ----
.damage-chart
  display grid
  grid-template-columns repeat(auto-fit, minmax(180px, 1fr))
  gap 16px
  margin-top 20px

  .chart-card
    background bg-card
    border 1px solid border-color
    border-radius 8px
    padding 16px
    text-align center

    h4
      color text-secondary
      font-size 12px
      margin-bottom 10px
      text-transform uppercase
      letter-spacing 1px

    .chart-value
      font-size 28px
      font-weight bold

      &.alpha-dmg
        color accent

      &.beta-dmg
        color danger

      &.total-dmg
        color warning

    .chart-label
      font-size 10px
      color text-muted
      margin-top 4px

// ---- Animations ----
@keyframes fadeIn
  from
    opacity 0
    transform translateY(-5px)
  to
    opacity 1
    transform translateY(0)

@keyframes shipHit
  0%
    transform scale(1)
  25%
    transform scale(1.05)
  50%
    transform scale(0.98)
    filter brightness(2)
  100%
    transform scale(1)
    filter brightness(1)

.ship-hit-animation
  animation shipHit 0.4s ease

@keyframes explode
  0%
    opacity 1
    transform scale(1)
  100%
    opacity 0
    transform scale(1.5)

.ship-destroyed-animation
  animation explode 0.6s ease forwards

// ---- Battle Result Overlay ----
.result-overlay
  display none
  position fixed
  inset 0
  background rgba(0, 0, 0, 0.85)
  z-index 1000
  justify-content center
  align-items center

  &.visible
    display flex

  .result-card
    background bg-card
    border 2px solid border-color
    border-radius 12px
    padding 40px
    text-align center
    max-width 500px
    width 90%

    .result-icon
      font-size 48px
      margin-bottom 16px

    .result-title
      font-size 28px
      font-weight bold
      letter-spacing 2px
      text-transform uppercase
      margin-bottom 8px

      &.victory
        color success

      &.defeat
        color danger

      &.draw
        color warning

    .result-summary
      font-size 13px
      color text-muted
      margin-bottom 20px
      line-height 1.8

    .result-actions
      display flex
      gap 10px
      justify-content center

      .btn
        padding 10px 22px
        border none
        border-radius 6px
        cursor pointer
        font-weight bold
        font-size 13px

      .btn-retry
        background accent
        color #fff

      .btn-detail
        background transparent
        border 1px solid border-color
        color accent

      .btn-close
        background transparent
        color text-muted

// ---- Responsive ----
@media (max-width: 768px)
  body
    padding 10px

  .battle-arena
    flex-direction column

  .battle-controls
    flex-direction row
    justify-content center

  .fleet-panel
    .fleet-ship-row
      flex-wrap wrap

  .damage-chart
    grid-template-columns 1fr
