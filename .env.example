# ============================================================
# 环境变量配置模板（.env.example）
# 复制为 .env 并填入真实值
# ============================================================
# 注意：此文件仅作为模板参考，不含真实密钥
# 实际 .env 文件已在 gitignore 中排除

# ---------- 必填配置 ----------
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- 管理员 ----------
ADMIN_PASSWORD=change_me_to_strong_password

# ---------- JWT ----------
JWT_SECRET=change_me_to_random_string

# ---------- 数据库 ----------
DATABASE_PATH=./lagrange.db
DB_BACKUP_DIR=./db_backup

# ---------- 向量库 ----------
CHROMA_DB_PATH=./chroma_db

# ---------- 文档路径 ----------
LAGRANGE_DOCS_PATH=./lagrange_docs
DESKTOP_MATERIALS_PATH=C:/Users/Administrator/Desktop/质料

# ---------- 服务器 ----------
HOST=0.0.0.0
PORT=3000
